      "required": [
        "search_id",
        "seq",
        "turn",
        "at_ms",
        "phase",
        "duration_ms"
      ],
      "title": "PhaseFinished",
      "type": "object"
    },
    "PhaseStarted": {
      "properties": {
        "at_ms": {
          "title": "At Ms",
          "type": "number"
        },
