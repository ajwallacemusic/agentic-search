{
  "$defs": {
    "Budget": {
      "properties": {
        "max_cost_usd": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Cost Usd"
        },
        "max_seconds": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": 60.0,
          "title": "Max Seconds"
        },
        "max_tokens": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Tokens"
        },
        "max_tool_calls": {
          "default": 32,
          "title": "Max Tool Calls",
          "type": "integer"
        },
        "max_turns": {
          "default": 4,
          "title": "Max Turns",
          "type": "integer"
        }
      },
      "title": "Budget",
      "type": "object"
    },
    "Hit": {
      "properties": {
        "content": {
          "description": "present only when the request sets include_content",
          "items": {
            "discriminator": {
              "mapping": {
                "image": "#/$defs/ImagePart",
                "structured": "#/$defs/StructuredPart",
                "text": "#/$defs/TextPart"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/TextPart"
              },
              {
                "$ref": "#/$defs/ImagePart"
              },
              {
                "$ref": "#/$defs/StructuredPart"
              }
            ]
          },
          "title": "Content",
          "type": "array"
        },
        "doc_id": {
          "title": "Doc Id",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "provenance": {
          "items": {
            "$ref": "#/$defs/OpRef"
          },
          "title": "Provenance",
          "type": "array"
        },
        "raw_score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw Score"
        },
        "source": {
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "doc_id",
        "source"
      ],
      "title": "Hit",
      "type": "object"
    },
    "HitSummary": {
      "properties": {
        "content": {
          "anyOf": [
            {
              "items": {
                "discriminator": {
                  "mapping": {
                    "image": "#/$defs/ImagePart",
                    "structured": "#/$defs/StructuredPart",
                    "text": "#/$defs/TextPart"
                  },
                  "propertyName": "kind"
                },
                "oneOf": [
                  {
                    "$ref": "#/$defs/TextPart"
                  },
                  {
                    "$ref": "#/$defs/ImagePart"
                  },
                  {
                    "$ref": "#/$defs/StructuredPart"
                  }
                ]
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content"
        },
        "doc_id": {
          "title": "Doc Id",
          "type": "string"
        },
        "first_turn": {
          "title": "First Turn",
          "type": "integer"
        },
        "judged": {
          "default": false,
          "title": "Judged",
          "type": "boolean"
        },
        "key": {
          "title": "Key",
          "type": "string"
        },
        "p_relevant": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "P Relevant"
        },
        "score": {
          "title": "Score",
          "type": "number"
        },
        "snippet": {
          "title": "Snippet",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        }
      },
      "required": [
        "key",
        "source",
        "doc_id",
        "snippet",
        "score",
        "first_turn"
      ],
      "title": "HitSummary",
      "type": "object"
    },
    "ImagePart": {
      "description": "An image, inline (`data`) or by reference (`uri`). In JSON, `data` is standard base64.",
      "properties": {
        "data": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "standard base64; null in the question of search_started and of a result, because the service does not echo question images back to the client",
          "title": "Data"
        },
        "kind": {
          "const": "image",
          "default": "image",
          "title": "Kind",
          "type": "string"
        },
        "mime": {
          "default": "image/png",
          "title": "Mime",
          "type": "string"
        },
        "uri": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Uri"
        }
      },
      "title": "ImagePart",
      "type": "object"
    },
    "OpRef": {
      "properties": {
        "call_id": {
          "title": "Call Id",
          "type": "string"
        },
        "rank": {
          "title": "Rank",
          "type": "integer"
        },
        "turn": {
          "title": "Turn",
          "type": "integer"
        }
      },
      "required": [
        "turn",
        "call_id",
        "rank"
      ],
      "title": "OpRef",
      "type": "object"
    },
    "PhaseFinished": {
      "properties": {
        "at_ms": {
          "title": "At Ms",
          "type": "number"
        },
        "duration_ms": {
          "title": "Duration Ms",
          "type": "number"
        },
        "phase": {
          "enum": [
            "plan",
            "query",
            "judge",
            "decide",
            "delegate"
          ],
          "title": "Phase",
          "type": "string"
        },
        "schema_version": {
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "search_id": {
          "title": "Search Id",
          "type": "string"
        },
        "seq": {
          "title": "Seq",
          "type": "integer"
        },
        "summary": {
          "$ref": "#/$defs/PhaseSummary"
